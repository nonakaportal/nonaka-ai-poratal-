# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# Supabase project (Settings > API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# QuickBooks Online app (Intuit Developer dashboard > Keys & OAuth)
QB_CLIENT_ID=your_quickbooks_client_id
QB_CLIENT_SECRET=your_quickbooks_client_secret
QB_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
# "sandbox" for a test company, "production" for a live QuickBooks company
QB_ENVIRONMENT=sandbox

# Claude API (console.anthropic.com). The models used are set in
# backend/services/ai/ai.service.js.
CLAUDE_API_KEY=your_claude_api_key

# Where the portal is served. Used for CORS, and for the redirects after
# QuickBooks OAuth, email confirmation and password reset. When the backend
# serves the frontend itself (the normal setup), this is the backend's own URL.
FRONTEND_URL=http://localhost:3000
