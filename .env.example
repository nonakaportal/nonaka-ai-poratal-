# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000
PUBLIC_API_BASE_URL=http://localhost:3000

# Supabase project (Settings > API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# QuickBooks Online app (Intuit Developer dashboard > Keys & OAuth)
QB_CLIENT_ID=your_quickbooks_client_id
QB_CLIENT_SECRET=your_quickbooks_client_secret
QB_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
# "sandbox" for a test company, "production" for a live QuickBooks company
QB_ENVIRONMENT=sandbox

# Claude API (console.anthropic.com)
CLAUDE_API_KEY=your_claude_api_key
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# URL the backend redirects back to after QuickBooks OAuth completes
FRONTEND_URL=http://127.0.0.1:5500
